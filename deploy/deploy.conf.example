# VPS connection for Olive Foods deploys (gitignored — not committed).
# Used by scripts/deploy.sh: build locally, ship a timestamped release, flip the
# `current` symlink, reload this project's own pm2 process.
DEPLOY_HOST="<your-vps-ip>"
DEPLOY_USER="deploy"
DEPLOY_PATH="/srv/olivefoods"
DEPLOY_SSH_PORT="22"
APP_NAME="olivefoods"
SITE_URL="https://www.olivefoods.lk"
KEEP_RELEASES="5"
